<!-- Derived from com.unity.render-pipelines.high-definition (Scene View camera settings) and com.unity.render-pipelines.universal (tooltips),
     copyright © Unity Technologies ApS. Licensed under the Unity Companion License (see LICENSE.md). -->
<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Rendering (Universal Plus)" class="header"/>
    <ui:Slider name="RenderScale" label="Render Scale" tooltip="Scales the camera render target allowing the game to render at a resolution different than native resolution. UI is always rendered at native resolution." low-value="0.1" high-value="3" value="1" show-input-field="true"/>
    <ui:EnumField name="AntiAliasing" label="Anti-aliasing" tooltip="The anti-aliasing mode used by the Scene View camera." type="UnityEngine.Rendering.Universal.AntialiasingMode, Unity.RenderPipelines.Universal.Runtime" />
    <ui:HelpBox name="TAAWarning" text="Temporal anti-aliasing in the Scene View is only supported when Always Refresh is enabled." message-type="Info"/>
    <ui:Toggle name="StopNaNs" label="Stop NaNs" tooltip="When enabled, any NaNs in the Scene View camera’s color buffer are suppressed."/>
    <ui:Toggle name="Dithering" label="Dithering" tooltip="Applies 8-bit dithering to the final render to reduce color banding."/>
</ui:UXML>
